programa {
    real nivel_do_mar
    cadeia horario_atual 
    
  funcao inicio() {
    escreva("nivel da maré? (em metros) ","\n")
    leia (nivel_do_mar)
    escreva("Tá chovendo? (Sim ou Não)")
    leia (horario_atual)
    se(nivel_do_mar >= 0.2 e horario_atual == Não){
        retorne escreva("Cuidado com o tubarão!!!")
    }
escreva ("Não pode, que pena!!!")
    
  }
}
