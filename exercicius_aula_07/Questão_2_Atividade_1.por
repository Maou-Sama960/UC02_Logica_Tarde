programa {
    real nivel_do_mar
    cadeia tempo_chuvoso 
    
  funcao inicio() {
    escreva("nivel da maré? (em metros) ","\n")
    leia (nivel_do_mar)
    escreva("Tá chovendo? (Sim ou Não)")
    leia (tempo_chuvoso)
    se(nivel_do_mar >= 0.4 e tempo_chuvoso == Não){
        retorne escreva("Cuidado com o tubarão!!!")
    }
escreva ("Não pode, que pena!!!")
    
  }
}
