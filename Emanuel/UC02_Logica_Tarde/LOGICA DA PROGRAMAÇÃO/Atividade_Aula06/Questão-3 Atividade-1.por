programa {
  funcao inicio() {
    cadeia nome
    real salario
    escreva ("qual nome do funciorio?","\n")
    leia (nome)
    escreva ("qual salario do funciorio?","\n")
    leia (salario)
    escreva ("Nome do funcionario: ",nome,"\n","Salario: ",salario,"\n","atualmente o funcionario ",nome," recebe ",salario," R$")
  }
}
