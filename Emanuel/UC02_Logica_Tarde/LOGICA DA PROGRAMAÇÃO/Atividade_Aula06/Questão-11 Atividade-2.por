programa {
  real numero1
  real numero2
  funcao inicio() {
    escreva ("Qual o valor do ingresso?","\n")
    leia(numero1)
    escreva ("Quantos alunos tem?","\n")
    leia(numero2)
    escreva("valor total: ",(numero1*numero2),"\n")
    escreva("valor total se for meia entrada: ",(numero1*numero2)/2)
  }
}
