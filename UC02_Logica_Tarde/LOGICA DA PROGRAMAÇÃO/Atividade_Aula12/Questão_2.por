programa {
  funcao inicio() {
    // DECLARAÇÃO
    real altura,base,area_triangulo
    // ENTRADA
    escreva("Base: ") 
    leia(base)
    escreva("Altura: ") 
    leia(altura)
    // PROCESSAMENTO
    area_triangulo = (base*altura)/2
    // SAÍDA
    escreva("Area do Triangulo: ",area_triangulo, "\n")

  }
}
